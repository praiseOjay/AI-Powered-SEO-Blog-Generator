# Which LLMs to try, in order. Providers without config are skipped; if none work, template copy is used.
LLM_PROVIDERS=workers-ai,gemini,ollama

# Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama (local dev / self-hosted), e.g. http://localhost:11434
OLLAMA_URL=
OLLAMA_MODEL=llama3.1:8b

# Workers AI needs no key; it is the `AI` binding on Cloudflare. Override the model if you like:
WORKERS_AI_MODEL=@cf/google/gemma-4-26b-a4b-it

# Optional: public origin for the sitemap (defaults to the request host)
NUXT_PUBLIC_SITE_URL=
